# =================================================================
# KERB CAMPUS TRANSIT (FUTMINNA) - ENVIRONMENT CONFIGURATION
# =================================================================

# Server Port & Mode
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# -----------------------------------------------------------------
# 1. PAYSTACK PAYMENT GATEWAY
# Get keys from: https://dashboard.paystack.com/#/settings/developer
# -----------------------------------------------------------------
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_PUBLIC_KEY="pk_test_..."
# Webhook URL to register in Paystack Dashboard:
# https://<your-domain>/api/payments/paystack-webhook

# -----------------------------------------------------------------
# 2. CELLULAR SMS OTP GATEWAYS (Termii / Twilio)
# -----------------------------------------------------------------
# Primary: Termii (Leading Nigerian SMS provider - https://termii.com)
TERMII_API_KEY=""
TERMII_SENDER_ID="KerbCampus"

# Fallback: Twilio (Global SMS provider - https://twilio.com)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# -----------------------------------------------------------------
# 3. PILOT REGISTRATION & BACKDOOR CONTROLS
# When Termii SMS Sender ID is pending telecom approval in Nigeria:
# ENABLE_PILOT_OTP_FALLBACK: Allows pilot users to complete self-registration
# using WhatsApp verification or fallback code while Sender ID is pending.
# Set to false once official SMS Sender ID is active on live telcos.
# -----------------------------------------------------------------
ENABLE_PILOT_OTP_FALLBACK=true
PILOT_FALLBACK_OTP="1234"

# -----------------------------------------------------------------
# 4. GOOGLE GEMINI REAL-TIME VOICE ASSISTANT
# Get key from: https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------
GEMINI_API_KEY=""

# -----------------------------------------------------------------
# 5. PRODUCTION RELATIONAL DATABASE (Optional)
# If provided, enables PostgreSQL connection pool instead of local JSON engine.
# Format: postgresql://username:password@localhost:5432/kerb_futminna
# -----------------------------------------------------------------
DATABASE_URL=""

# -----------------------------------------------------------------
# 6. DISTANCE ROUTING & FARE ENGINE (OpenRouteService & Quote Security)
# Free API key from https://openrouteservice.org/dev/#/signup
# -----------------------------------------------------------------
ORS_API_KEY=""
QUOTE_SECRET="replace_with_64_character_random_hex_secret"
